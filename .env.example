# Cloudflare Workers AI credentials
# Copy this file to .env and fill in the values from the Cloudflare dashboard.
Account ID=your_cloudflare_account_id
API KEY=your_cloudflare_workers_ai_api_token

# Optional overrides
# INVESTIGATION_LLM_PROVIDER=cloudflare
# INVESTIGATION_LLM_MODEL=@cf/meta/llama-4-scout-17b-16e-instruct
# INVESTIGATION_LLM_TEXT_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# INVESTIGATION_LLM_IMAGE_MODEL=@cf/black-forest-labs/flux-2-dev
# INVESTIGATION_LLM_TIMEOUT=120
