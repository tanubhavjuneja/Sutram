# INVESTIGATION_LLM_TEXT_MODEL=@cf/meta/llama-3.1-8b-instruct
# INVESTIGATION_LLM_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
# INVESTIGATION_LLM_TIMEOUT=120
